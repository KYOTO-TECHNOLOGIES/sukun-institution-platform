# Copy to deploy/production.env; generate independent secrets before use.
SECRET_KEY=replace-with-at-least-50-random-characters-generated-for-this-deployment
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ALLOWED_HOSTS=lms.example.org,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://lms.example.org
TIME_ZONE=Asia/Kolkata
ALLOW_INSTITUTION_REGISTRATION=False
# Terminate HTTPS at your reverse proxy. Bind the app only to loopback.
JWT_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
TRUST_PROXY_SSL_HEADER=True
