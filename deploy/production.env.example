# Copy to deploy/production.env; generate independent secrets before use.
SECRET_KEY=replace-with-at-least-50-random-characters-generated-for-this-deployment
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ALLOWED_HOSTS=lms.example.org,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://lms.example.org
TIME_ZONE=Asia/Kolkata
ALLOW_INSTITUTION_REGISTRATION=False
# Legal issuer snapshots for newly issued software invoices.
BILLING_BUSINESS_NAME=Sukun
BILLING_BUSINESS_ADDRESS=
BILLING_SUPPORT_EMAIL=
BILLING_TAX_ID=
# A trusted server-side payment adapter can use this signed event boundary.
# Generate a secret of at least 32 characters; leave empty to disable.
BILLING_WEBHOOK_SECRET=
# Optional external AI. Both values and institution consent are required.
OPENAI_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_DAILY_LIMIT=100
# Terminate HTTPS at your reverse proxy. Bind the app only to loopback.
JWT_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
TRUST_PROXY_SSL_HEADER=True
# HTTPS edge proxy followed by the private Nginx frontend.
TRUSTED_PROXY_COUNT=2

# Private WebSocket rooms: Redis is required in production.
REDIS_URL=redis://redis:6379/0
# Defaults to CSRF_TRUSTED_ORIGINS. List each browser origin explicitly.
# WEBSOCKET_ALLOWED_ORIGINS=https://school.example.com
