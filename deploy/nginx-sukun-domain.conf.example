# Dedicated host Nginx site: https://lms.sukunweb.com
# Enable only after its certificate exists. Do not enable the bootstrap site too.
# SUKUN_HTTP_PORT must match the private upstream port below.
map $http_upgrade $sukun_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name lms.sukunweb.com;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/sukun-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 301 https://lms.sukunweb.com$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name lms.sukunweb.com;
    ssl_certificate /etc/letsencrypt/live/lms.sukunweb.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lms.sukunweb.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 10m;
    access_log /var/log/nginx/sukun-access.log;
    error_log /var/log/nginx/sukun-error.log;

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $sukun_connection_upgrade;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        proxy_buffering off;
    }
}
