# Add this as its own file inside the existing host Nginx http {} includes.
# Replace 203.0.113.10 with your public IPv4 address or dedicated hostname.
# A certificate must cover that exact IP/hostname. Do not use placeholder files.
# Public HTTPS: 8443. Private Docker frontend: 127.0.0.1:18080.
# Change both this upstream and SUKUN_HTTP_PORT together if 18080 is occupied.
map $http_upgrade $sukun_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 8443 ssl;
    server_name 203.0.113.10;

    ssl_certificate /etc/nginx/ssl/sukun/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/sukun/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 10m;
    access_log /var/log/nginx/sukun-access.log;
    error_log /var/log/nginx/sukun-error.log;

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        # Preserve the public nonstandard port for origins, links and redirects.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # This edge is the first trusted proxy; discard client-supplied XFF.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $sukun_connection_upgrade;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        proxy_buffering off;
    }
}
